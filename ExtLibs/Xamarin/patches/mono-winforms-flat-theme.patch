+		#region Flat look
+		// A colour part way from back towards white on a dark background, or towards black on a light one
+		internal static Color FlatShade (Color back, int percent)
+		{
+			bool dark = (back.R * 299 + back.G * 587 + back.B * 114) / 1000 < 128;
+			int target = dark ? 255 : 0;
+			return Color.FromArgb (255,
+				back.R + (target - back.R) * percent / 100,
+				back.G + (target - back.G) * percent / 100,
+				back.B + (target - back.B) * percent / 100);
+		}
+
+		// fore taken part way towards back, for dimmed text and glyphs
+		internal static Color FlatBlend (Color fore, Color back, int percent)
+		{
+			return Color.FromArgb (255,
+				fore.R + (back.R - fore.R) * percent / 100,
+				fore.G + (back.G - fore.G) * percent / 100,
+				fore.B + (back.B - fore.B) * percent / 100);
+		}
+
+		// fore, unless it is too close to back to read, then white or black, whichever back is not
+		internal static Color FlatReadable (Color fore, Color back)
+		{
+			int fore_lum = (fore.R * 299 + fore.G * 587 + fore.B * 114) / 1000;
+			int back_lum = (back.R * 299 + back.G * 587 + back.B * 114) / 1000;
+			if (Math.Abs (fore_lum - back_lum) >= 90)
+				return fore;
+			return back_lum < 128 ? Color.White : Color.Black;
+		}
+
+		// A thin chevron pointing the way of direction, centred in area
+		internal static void DrawFlatArrow (Graphics dc, Rectangle area, ScrollButton direction, Color color)
+		{
+			float size = Math.Max (2, Math.Min (area.Width, area.Height) / 5);
+			float half = size / 2f;
+			float cx = area.X + area.Width / 2f;
+			float cy = area.Y + area.Height / 2f;
+			PointF[] points;
+
+			switch (direction) {
+			case ScrollButton.Up:
+				points = new PointF[] { new PointF (cx - size, cy + half), new PointF (cx, cy - half), new PointF (cx + size, cy + half) };
+				break;
+			case ScrollButton.Left:
+				points = new PointF[] { new PointF (cx + half, cy - size), new PointF (cx - half, cy), new PointF (cx + half, cy + size) };
+				break;
+			case ScrollButton.Right:
+				points = new PointF[] { new PointF (cx - half, cy - size), new PointF (cx + half, cy), new PointF (cx - half, cy + size) };
+				break;
+			default:
+				points = new PointF[] { new PointF (cx - size, cy - half), new PointF (cx, cy + half), new PointF (cx + size, cy - half) };
+				break;
+			}
+
+			SmoothingMode old_mode = dc.SmoothingMode;
+			dc.SmoothingMode = SmoothingMode.AntiAlias;
+			using (Pen pen = new Pen (color, 1.6f)) {
+				pen.StartCap = LineCap.Round;
+				pen.EndCap = LineCap.Round;
+				pen.LineJoin = LineJoin.Round;
+				dc.DrawLines (pen, points);
+			}
+			dc.SmoothingMode = old_mode;
+		}
+
+		// A borderless button the colour of its control with a chevron on it; shade lightens or darkens it
+		// for hover (about 6) and pressed (about 12)
+		internal static void DrawFlatArrowButton (Graphics dc, Rectangle area, ScrollButton direction, int shade, bool enabled, Color back, Color fore)
+		{
+			using (SolidBrush brush = new SolidBrush (shade > 0 ? FlatShade (back, shade) : back))
+				dc.FillRectangle (brush, area);
+			DrawFlatArrow (dc, area, direction, FlatBlend (fore, back, enabled ? 20 : 65));
+		}
+
+		internal static GraphicsPath FlatRoundedRect (RectangleF rect, float radius)
+		{
+			GraphicsPath path = new GraphicsPath ();
+			float dia = Math.Min (radius * 2, Math.Min (rect.Width, rect.Height));
+			if (dia < 1) {
+				path.AddRectangle (rect);
+				return path;
+			}
+			path.AddArc (rect.Left, rect.Top, dia, dia, 180, 90);
+			path.AddArc (rect.Right - dia, rect.Top, dia, dia, 270, 90);
+			path.AddArc (rect.Right - dia, rect.Bottom - dia, dia, dia, 0, 90);
+			path.AddArc (rect.Left, rect.Bottom - dia, dia, dia, 90, 90);
+			path.CloseFigure ();
+			return path;
+		}
