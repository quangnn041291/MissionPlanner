+		protected override void OnMouseWheel (MouseEventArgs e)
+		{
+			base.OnMouseWheel (e);
+
+			// over the tabs, scroll them as the buttons do
+			if (!ShowSlider || e.Delta == 0 || DisplayRectangle.Contains (e.Location))
+				return;
