+		// the lowest row that can be at the top with the grid still full below it. hidden rows,
+		// such as those a filter leaves out, take no room
+		private int LastTopVisibleRowIndex ()
+		{
+			int room = ClientSize.Height - (ColumnHeadersVisible ? ColumnHeadersHeight : 0) -
+				(horizontalScrollBar.Visible ? horizontalScrollBar.Height : 0);
+			int last = -1;
+			int below = 0;
+			for (int index = Rows.Count - 1; index >= 0; index--) {
+				DataGridViewRow row = Rows.SharedRow (index);
+				if (!row.Visible)
+					continue;
+				if (last == -1)
+					last = index;
+				below += row.Height;
+				if (below > room)
+					break;
+				last = index;
+			}
+			return Math.Max (0, last);
